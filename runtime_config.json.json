{
  "target": "bmv2",
  "p4info": "build/ismu.p4info.txt",
  "bmv2_json": "build/ismu.json",

  "table_entries": [
    {
      "table": "Ingress.ipv4_lpm",
      "match": {
        "hdr.ipv4.dstAddr": ["10.0.0.0", 24]
      },
      "action_name": "Ingress.ipv4_forward",
      "action_params": {
        "dstAddr": "08:00:00:00:00:01",
        "port": 1
      }
    },
    {
      "table": "Ingress.ipv4_lpm",
      "match": {
        "hdr.ipv4.dstAddr": ["10.0.1.0", 24]
      },
      "action_name": "Ingress.ipv4_forward",
      "action_params": {
        "dstAddr": "08:00:00:00:00:02",
        "port": 2
      }
    },
    {
      "table": "Ingress.detection_table",
      "match": {
        "hdr.ipv4.srcAddr": "10.0.0.5"
      },
      "action_name": "Ingress.mark_attack",
      "action_params": {}
    }
  ],

  "multicast_group_entries": [],

  "clone_session_entries": [],

  "meter_entries": [],

  "counter_entries": [
    {
      "counter": "Ingress.flow_counter",
      "index": 0,
      "data": {
        "packets": 0,
        "bytes": 0
      }
    }
  ]
}